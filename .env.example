# =============================================================================
# TFM — Forecasting de Demanda Energética en España
# Plantilla de variables de entorno
#
# INSTRUCCIONES:
#   1. Copia este fichero: cp .env.example .env
#   2. Rellena tus credenciales reales en .env
#   3. NUNCA subas .env al repositorio (ya está en .gitignore)
# =============================================================================

# --- REE / e·sios ---
# Registro gratuito en: https://esios.ree.es
# El token se solicita por email y llega en 1-2 días laborables
REE_API_TOKEN=tu_token_aqui

# --- AEMET OpenData ---
# Registro gratuito en: https://opendata.aemet.es
# El API key es inmediato tras el registro
AEMET_API_KEY=tu_api_key_aqui
